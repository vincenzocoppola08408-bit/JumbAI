{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "functions": {
    "pages/api/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/#pricing",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/?login=1",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "/?login=1",
      "permanent": false
    },
    {
      "source": "/generator",
      "destination": "/app",
      "permanent": true
    }
  ]
}